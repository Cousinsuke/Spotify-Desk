[Unit]
Description=Spotify Desk sample-only HTTPS device gateway
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/Projects/Spotify-Desk-Echo-Prototype
ExecStart="%h/Projects/Spotify-Desk-Echo-Prototype/.venv/bin/python" "%h/Projects/Spotify-Desk-Echo-Prototype/Echo Show 5 Gen 1/prototype/device_gateway.py" serve
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
