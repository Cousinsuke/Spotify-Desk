#!/usr/bin/env python3
"""Local-only Echo preview launcher; .env is data, never shell code."""
import getpass
import os
from pathlib import Path
import re
import stat
import sys
from urllib.parse import urlsplit

KEYS = ("SPOTIPY_CLIENT_ID", "DESK_GLUCOSE_URL", "DESK_GLUCOSE_API_SECRET_SHA1")
APPLE_KEYS = ("DESK_ICLOUD_USERNAME", "DESK_ICLOUD_APP_PASSWORD")
HERE = Path(__file__).resolve().parent


def validate(values):
    for key in KEYS:
        value = values.get(key, "")
        if not value or any(c.isspace() or ord(c) < 32 for c in value):
            raise ValueError(f"Missing or invalid {key}.")
    try:
        url = urlsplit(values[KEYS[1]])
        valid_url = url.scheme == "https" and url.hostname and not (url.username or url.password or url.query or url.fragment)
    except ValueError:
        valid_url = False
    if not valid_url:
        raise ValueError("DESK_GLUCOSE_URL must be an HTTPS base URL without credentials, query or fragment.")
    if not re.fullmatch(r"[0-9a-fA-F]{40}", values[KEYS[2]]):
        raise ValueError("DESK_GLUCOSE_API_SECRET_SHA1 must contain exactly 40 hexadecimal characters.")
    apple = [values.get(key, "") for key in APPLE_KEYS]
    if any(apple):
        if not all(apple) or any(any(c.isspace() or ord(c) < 32 for c in value) for value in apple):
            raise ValueError("Set both iCloud username and app-specific password, or leave both blank.")
        if not re.fullmatch(r"[A-Za-z0-9]{4}(?:-[A-Za-z0-9]{4}){3}", apple[1]):
            raise ValueError("DESK_ICLOUD_APP_PASSWORD must be the generated app-specific password (four groups of four characters).")
    return values


def parse(content):
    values = {}
    for number, line in enumerate(content.splitlines(), 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        key, sep, value = line.partition("=")
        if not sep or key not in KEYS + APPLE_KEYS or key in values:
            raise ValueError(f"Invalid or duplicate setting on .env line {number}.")
        values[key] = value.strip()
    return validate(values)


def load(path):
    with os.fdopen(os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK), "r", encoding="utf-8") as file:
        info = os.fstat(file.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
            raise ValueError(".env must be a regular file owned by you with permissions 600 (or stricter).")
        return parse(file.read(16385))


def setup(path):
    if not sys.stdin.isatty() or not sys.stderr.isatty():
        raise ValueError("First-run setup requires an interactive terminal.")
    print("First-run setup: enter the three existing credentials locally (input hidden).")
    values = validate({key: getpass.getpass(key + ": ").strip() for key in KEYS})
    with os.fdopen(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "w", encoding="utf-8") as file:
        file.write("\n".join(key + "=" + values[key] for key in KEYS) + "\n")
    print("Saved private .env (owner access only).", flush=True)
    return values


def main():
    args = sys.argv[1:]
    if args not in ([], ["--production"]):
        raise ValueError("Usage: start-live [--production]")
    root = HERE.parent.parent
    python = root / ".venv/bin/python"
    if not os.access(python, os.X_OK):
        raise ValueError("Missing preview virtual environment; create .venv and install requirements-ui.txt first.")
    path = HERE / ".env"
    try:
        values = load(path)
    except FileNotFoundError:
        if args:
            raise ValueError("Configure .env interactively using start-live before enabling production.")
        values = setup(path)
    env = dict(os.environ, **values)
    for key in APPLE_KEYS:
        env[key] = values.get(key, "")
    os.chdir(root)
    print("Starting Echo preview: http://127.0.0.1:8765/?live=1", flush=True)
    os.execve(python, [str(python), str(HERE / "live_server.py"), *args], env)


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, UnicodeError) as error:
        print("Launcher: " + (str(error) if type(error) is ValueError else "Unable to read/write local configuration or start the server."), file=sys.stderr)
        sys.exit(1)
    except (KeyboardInterrupt, EOFError):
        print("\nSetup cancelled.", file=sys.stderr)
        sys.exit(1)
